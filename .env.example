# Copie para .env e ajuste. NUNCA envie o .env ao GitHub.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/secretaria
# Opcional (Neon): conexão direta, usada só no "python app.py migrate"
# DATABASE_URL_DIRECT=
# Banco SEPARADO para testes (o nome deve terminar em _test; é zerado a cada execução)
TEST_DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/secretaria_test
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_LOGIN=admin
ADMIN_PASSWORD=defina-uma-senha-forte
# Teste local sem tela de login (REMOVER depois dos testes). Só funciona com HOST=127.0.0.1
DEV_SEM_LOGIN=0
PORT=5000
HOST=127.0.0.1
# Em produção (HTTPS): COOKIE_SECURE=1 e HOST=0.0.0.0
COOKIE_SECURE=0
